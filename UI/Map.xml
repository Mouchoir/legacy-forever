<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<!-- An unfinished Legacy objective on the world map, a frame of ours on the map's canvas (UI/MapCanvas.lua) wearing
	     ObjectivePin from UI/Map.lua. Left-click travels there; right-click passes through to zoom the map out, and a
	     continent's zone badge passes every click through. At a dungeon or raid entrance it is the game's entrance
	     portal wearing the shield as a badge; ObjectivePin:Layout sets it out on every acquire. -->
	<Frame name="LegacyForeverPinTemplate" virtual="true">
		<Size x="20" y="20"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Portal" setAllPoints="true" hidden="true"/>
			</Layer>
			<Layer level="ARTWORK">
				<!-- art-ok: ObjectivePin:Layout sizes it with Art.Fit on every acquire -->
				<Texture parentKey="Icon" atlas="UI-Legacy-Points-icon-c60"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Highlight" alphaMode="ADD" alpha="0.5" hidden="true"/>
			</Layer>
		</Layers>
	</Frame>

	<!-- The Legacy shield in the map's top-right button column, with its count inside. -->
	<DropdownButton name="LegacyForeverMapButtonTemplate" frameStrata="HIGH" mixin="LegacyForeverMapButtonMixin" virtual="true">
		<Size x="32" y="44"/>
		<KeyValues>
			<KeyValue key="menuPoint" type="string" value="TOPRIGHT"/>
			<KeyValue key="menuRelativePoint" type="string" value="BOTTOMRIGHT"/>
		</KeyValues>
		<Layers>
			<Layer level="ARTWORK">
				<!-- art-ok: 30 by 44 is the 50 by 73 shield's own shape, within half a percent -->
				<Texture parentKey="Icon" atlas="UI-Legacy-Points-icon-c60">
					<Size x="30" y="44"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Count" inherits="GameFontNormal" justifyH="CENTER">
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Icon" x="0" y="-4"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<!-- art-ok: the Icon again at the same 30 by 44, the shield's own shape -->
				<Texture atlas="UI-Legacy-Points-icon-c60" alphaMode="ADD" alpha="0.5">
					<Size x="30" y="44"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</DropdownButton>
</Ui>
